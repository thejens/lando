/target

# Node identity: contains the machine and node private keys.
.lando-state

# Pre-auth key. A tailnet-joining credential until used or revoked.
.lando-authkey

# Firmware build output (its own workspace, so its own target dir).
/crates/lando-fw/target

# WiFi credentials for firmware provisioning.
.lando-wifi

# CYW43 radio firmware blobs. Redistributable under their own permissive
# binary licence, not this repo's MIT — fetched by `make cyw43-firmware`
# rather than vendored, so the licences stay separate.
/crates/lando-fw/cyw43-firmware

# Hosted-tailnet pre-auth key.
.lando-tskey

# Tailscale API access token (full tailnet admin).
.lando-tsapi
